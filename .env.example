# Direct-provider settings. Values belong in the local environment only.
# Phase 2B uses DeepSeek V4 Pro for both model lanes.
BREAKFIX_PROVIDER=deepseek
BREAKFIX_DEEPSEEK_API_KEY=
BREAKFIX_DEEPSEEK_BASE_URL=https://api.deepseek.com
BREAKFIX_MODEL=deepseek-v4-pro
BREAKFIX_REASONING_EFFORT=high
BREAKFIX_MAX_OUTPUT_TOKENS=2000
BREAKFIX_MAX_RETRIES=2
BREAKFIX_PHASE2B_TRUTH_PATH=
# Used only for a non-DeepSeek OpenAI-compatible provider.
BREAKFIX_OPENAI_API_KEY=
BREAKFIX_OPENAI_BASE_URL=https://api.openai.com/v1
BREAKFIX_COST_INPUT_PER_1K=
BREAKFIX_COST_OUTPUT_PER_1K=
