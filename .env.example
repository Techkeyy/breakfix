# Phase 2A direct-provider settings. Values belong in the local environment only.
BREAKFIX_AGENT_PROVIDER=openai-compatible
BREAKFIX_OPENAI_API_KEY=
BREAKFIX_OPENAI_BASE_URL=https://api.openai.com/v1
BREAKFIX_MODEL=gpt-5.6-luna
BREAKFIX_REASONING_EFFORT=xhigh
BREAKFIX_TEMPERATURE=0
BREAKFIX_MAX_OUTPUT_TOKENS=2000
# Set both rates in USD per 1,000 tokens to calculate cost telemetry.
BREAKFIX_COST_INPUT_PER_1K=
BREAKFIX_COST_OUTPUT_PER_1K=
